<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ECepeda_Examen.Views.Registro"
             Title="Registro">

    <ContentPage.Resources>
        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label x:Name="lblUsuario"
                   Style="{StaticResource LabelGlobal}"
                   HorizontalTextAlignment="End"/>

            <Label
                Text="REGISTRO"
                TextColor="Blue"
                FontSize="22"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre"
                       Style="{StaticResource LabelGlobal}"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <Label Text="Apellido"
                       Style="{StaticResource LabelGlobal}"
                       Grid.Row="0"
                       Grid.Column="1"/>
                <Label Text="Edad"
                       Style="{StaticResource LabelGlobal}"
                       Grid.Row="0"
                       Grid.Column="2"/>

                <Entry x:Name="txtNombre"
                       Style="{StaticResource styleEntry}"
                       Placeholder="Ingresar Nombre"
                       Grid.Row="1"
                       Grid.Column="0"/>
                <Entry x:Name="txtApellido"
                       Style="{StaticResource styleEntry}"
                       Placeholder="Ingresar Apellido"
                       Grid.Row="1"
                       Grid.Column="1"/>
                <Entry x:Name="txtEdad"
                       Style="{StaticResource styleEntry}"
                       Placeholder="Ingresar Edad"
                       Keyboard="Numeric"
                       MaxLength="3"
                       Grid.Row="1"
                       Grid.Column="2"/>
            </Grid>

            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Fecha de inicio"
                       Style="{StaticResource LabelGlobal}"
                       VerticalOptions="Center"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <DatePicker x:Name="dpFechaInicio"
                            Format="dd/MM/yyyy"
                            Grid.Row="0"
                            Grid.Column="1"/>

                <Label Text="Plan"
                       Style="{StaticResource LabelGlobal}"
                       VerticalOptions="Center"
                       Grid.Row="1"
                       Grid.Column="0"/>
                <Picker x:Name="pkPlan"
                        Title="Seleccione el plan"
                        Grid.Row="1"
                        Grid.Column="1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Casillero"
                       Style="{StaticResource LabelGlobal}"
                       VerticalOptions="Center"
                       Grid.Row="2"
                       Grid.Column="0"/>
                <Switch x:Name="swCasillero"
                        HorizontalOptions="Start"
                        Grid.Row="2"
                        Grid.Column="1"/>

                <Label Text="Monto Inicial"
                       Style="{StaticResource LabelGlobal}"
                       VerticalOptions="Center"
                       Grid.Row="3"
                       Grid.Column="0"/>
                <Entry x:Name="txtMontoInicial"
                       Style="{StaticResource styleEntry}"
                       Placeholder="Entre 120 y 600"
                       Keyboard="Numeric"
                       Grid.Row="3"
                       Grid.Column="1"/>

                <Button x:Name="btnCalcular"
                        Style="{StaticResource BotonGlobal}"
                        Text="Calcular Pago mensual"
                        Clicked="btnCalcular_Clicked"
                        Grid.Row="4"
                        Grid.Column="0"/>
                <Entry x:Name="txtPagoMensual"
                       Style="{StaticResource styleEntry}"
                       Placeholder="Pago mensual"
                       IsReadOnly="True"
                       Grid.Row="4"
                       Grid.Column="1"/>
            </Grid>

            <Button x:Name="btnVerResumen"
                    Style="{StaticResource BotonGlobal}"
                    Text="Ver Resumen"
                    Clicked="btnVerResumen_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
